# Copy to .env and adjust. Never commit real credentials (these are all fake/local).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Emulator image: minstack = zero signup; swap to localstack/localstack (+ token) if you prefer
EMULATOR_IMAGE=ministackorg/ministack
# LOCALSTACK_AUTH_TOKEN=your-token-here
